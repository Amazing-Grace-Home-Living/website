rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function hasOptionalTimestamp(data, field) {
      return !data.keys().hasAny([field]) || data[field] is timestamp;
    }

    function hasOptionalShortString(data, field, maxLen) {
      return !data.keys().hasAny([field]) || (data[field] is string && data[field].size() <= maxLen);
    }

    // Public content (blog posts, game info)
    match /public/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User‑specific data (profile, points, progress)
    match /users/{userId}/{sub=**} {
      allow read, write: if isSelf(userId);
    }

    // Chat rooms – anyone logged in can read / create messages.
    // Updates / deletes only by the original author, and the authorUid cannot be changed.
    match /lmsChats/{roomId}/messages/{msgId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly([
                      'authorUid',
                      'text',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.keys().hasAll(['authorUid', 'text', 'createdAt'])
                    && request.resource.data.authorUid == request.auth.uid
                    && isShortString(request.resource.data.authorUid, 128)
                    && isShortString(request.resource.data.text, 2000)
                    && request.resource.data.createdAt is timestamp
                    && hasOptionalTimestamp(request.resource.data, 'updatedAt');

      // Update: author must match and must not be changed
      allow update: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.keys().hasOnly([
                      'authorUid',
                      'text',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.keys().hasAll(['authorUid', 'text', 'createdAt'])
                    && isShortString(request.resource.data.authorUid, 128)
                    && isShortString(request.resource.data.text, 2000)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && hasOptionalTimestamp(request.resource.data, 'updatedAt');

      // Delete: author must match
      allow delete: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid;
    }

    // Points store – readable only by owner; writes must be server-side.
    match /wallets/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // Additional data models for the LMS
    // -----------------------------------------------------------------

    // Games collection – each game document stores state, scores etc.
    match /games/{gameId} {
      // Anyone can read game data (e.g., public leaderboards)
      allow read: if true;

      // Owner can create; ownerUid must be immutable and bounded.
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && isShortString(request.resource.data.ownerUid, 128)
                    && request.resource.data.keys().size() <= 25
                    && hasOptionalShortString(request.resource.data, 'title', 160)
                    && hasOptionalTimestamp(request.resource.data, 'createdAt')
                    && hasOptionalTimestamp(request.resource.data, 'updatedAt');

      allow update: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && isShortString(request.resource.data.ownerUid, 128)
                    && request.resource.data.keys().size() <= 25
                    && hasOptionalShortString(request.resource.data, 'title', 160)
                    && hasOptionalTimestamp(request.resource.data, 'updatedAt');

      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Store items – catalog of purchasable items (read‑only for users)
    match /store/{itemId} {
      // Public read of catalog
      allow read: if true;
      // Write only by an admin account (replace with real admin UID later)
      allow write: if request.auth != null && request.auth.uid == "ADMIN_UID_PLACEHOLDER";
    }

    // Donations – immutable records created by a trusted server (Cloud Function)
    match /donations/{donationId} {
      // The donor can read their own donation record
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
      // Client writes denied; trusted server uses Admin SDK and bypasses rules.
      allow create: if false;
      // No updates or deletes allowed (audit trail)
      allow update, delete: if false;
    }

  }
}
