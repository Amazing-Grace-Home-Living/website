rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public content (blog posts, game info)
    match /public/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User‑specific data (profile, points, progress)
    match /users/{userId}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Chat rooms – anyone logged in can read / create messages.
    // Updates / deletes only by the original author, and the authorUid cannot be changed.
    match /lmsChats/{roomId}/messages/{msgId} {
      allow read, create: if request.auth != null;

      // Update: author must match and must not be changed
      allow update: if request.auth != null
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == resource.data.authorUid;

      // Delete: author must match
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // Points store – only the owning user can modify their wallet
    match /wallets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // -----------------------------------------------------------------
    // Additional data models for the LMS
    // -----------------------------------------------------------------

    // Games collection – each game document stores state, scores etc.
    match /games/{gameId} {
      // Anyone can read game data (e.g., public leaderboards)
      allow read: if true;
      // Owner of the game document can create / update / delete it
      allow create, update, delete: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
    }

    // Store items – catalog of purchasable items (read‑only for users)
    match /store/{itemId} {
      // Public read of catalog
      allow read: if true;
      // Write only by an admin account (replace with real admin UID later)
      allow write: if request.auth != null && request.auth.uid == "ADMIN_UID_PLACEHOLDER";
    }

    // Donations – immutable records created by a trusted server (Cloud Function)
    match /donations/{donationId} {
      // The donor can read their own donation record
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // Only server‑side admin (no auth) may create a donation entry
      allow create: if request.auth == null;
      // No updates or deletes allowed (audit trail)
      allow update, delete: if false;
    }

  }
}
