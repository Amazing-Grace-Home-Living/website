{
  "manifest_version": 3,
  "name": "Nexus Toolbox",
  "version": "1.1.0",
  "description": "Local, user-triggered active-tab inspection and host-tool guidance.",
  "action": {
    "default_popup": "host-panel.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
