{
  "name": "nexus-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node bridge.mjs",
    "test:academy": "node --test tests/academy.test.mjs",
    "test:academy:browser": "node tests/academy-browser.mjs",
    "setup:provider": "node credential-setup.mjs",
    "test:providers": "node --test tests/providers.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:arcade": "node --test tests/academy.test.mjs tests/learning.test.mjs tests/tower-defense.test.mjs tests/sovereign.test.mjs tests/matrix-rpg.test.mjs tests/vim-defense.test.mjs tests/match3.test.mjs tests/progress.test.mjs tests/matchmaker.test.mjs tests/transfer.test.mjs tests/defense-input.test.mjs tests/bonus.test.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "test:learning": "node --test tests/learning.test.mjs tests/tower-defense.test.mjs tests/sovereign.test.mjs tests/matrix-rpg.test.mjs tests/vim-defense.test.mjs tests/match3.test.mjs tests/progress.test.mjs tests/matchmaker.test.mjs tests/transfer.test.mjs",
    "test:learning:browser": "node tests/learning-browser.mjs",
    "test:rpg": "node --test tests/matrix-rpg.test.mjs",
    "test:rpg:browser": "node tests/matrix-rpg-browser.mjs",
    "test:vim-defense": "node --test tests/vim-defense.test.mjs",
    "test:vim-defense:browser": "node tests/vim-defense-browser.mjs",
    "test:matrix-academy": "node --test tests/match3.test.mjs",
    "test:matrix-academy:browser": "node tests/matrix-academy-browser.mjs",
    "test:code-matrix": "node --test tests/match3.test.mjs tests/matchmaker.test.mjs tests/bonus.test.mjs",
    "test:code-matrix:browser": "node tests/matrix-academy-browser.mjs",
    "test:tools:browser": "node tests/ai-setup-browser.mjs",
    "balance:matrix": "node scripts/simulate-matrix.mjs",
    "test:progress": "node --test tests/transfer.test.mjs",
    "test:progress:browser": "node tests/transfer-browser.mjs",
    "pretest:local": "powershell -ExecutionPolicy Bypass -File ./cleanup-chrome.ps1",
    "test:local": "node ./run-authenticated-tests.mjs",
    "posttest:local": "powershell -ExecutionPolicy Bypass -File ./cleanup-chrome.ps1",
    "security:scan": "bash ./.github/verify-no-secrets.sh",
    "prepare": "git config core.hooksPath .github/hooks --if-present || true",
    "check": "npm run lint && npm run test && npm run build && tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
