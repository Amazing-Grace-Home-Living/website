rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Donations are readable by any authenticated user, creation only by the donor
    match /donations/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // Point transaction logs – only the owner can read/write their own logs
    match /pointTransactions/{docId} {
      allow read, create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    // Profiles collection mirrors users (optional)
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

