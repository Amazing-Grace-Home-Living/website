rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Every private upload belongs to a signed-in user; no anonymous writes.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // All legacy paths remain private until individually reviewed and migrated.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
